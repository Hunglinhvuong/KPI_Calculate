# Sao chép thành .env và điền giá trị thật. KHÔNG commit file .env.

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DB=kpi_dashboard
PG_USER=
PG_PASSWORD=
PG_CONNECT_TIMEOUT=10

# Admin của dashboard (các trang dữ liệu vẫn xem được khi chưa đăng nhập)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Streamlit (service installer chỉ chấp nhận các cổng 8502-8505)
STREAMLIT_PORT=8502

# Oracle
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=host:1521/service_name
ORACLE_TABLE=VMTCL_2026_WARD_DAY_V2
ORACLE_PROVINCE=Nghe An
ORACLE_TIMEOUT_SEC=60

# VHKT (Playwright)
VHKT_URL=
VHKT_USER=
VHKT_PASSWORD=
VHKT_PROVINCE=Nghe An
VHKT_TIMEOUT_SEC=60
# Có thể dùng cặp SMARTF_USER/SMARTF_PASS thay cho VHKT_USER/VHKT_PASSWORD
# để tương thích với database/smartF_playwright_v3.py.
SMARTF_USER=
SMARTF_PASS=

# Thu thập
COLLECT_MAX_RETRY=3
LOG_DIR=logs
